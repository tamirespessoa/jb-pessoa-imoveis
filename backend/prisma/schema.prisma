generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  CORRETOR
  RECEPCIONISTA
  ANALISTA_CREDITO
  USER
}

enum PropertyStatus {
  DISPONIVEL
  RESERVADO
  EM_ANALISE
  VENDIDO
  LOCADO
  ARQUIVADO
}

enum LeadStatus {
  NOVO
  CONTATO_REALIZADO
  EM_ATENDIMENTO
  QUALIFICADO
  SIMULACAO
  VISITA_AGENDADA
  VISITA_REALIZADA
  PROPOSTA
  DOCUMENTACAO
  ATENDIDO
  CONVERTIDO
  SEM_RESPOSTA
  SEM_RENDA
  SEM_ENTRADA
  NAO_INTERESSADO
  INVALIDO
  DESCARTADO
  PERDIDO
}

enum LeadTemperature {
  FRIO
  MORNO
  QUENTE
}

enum ConversationStatus {
  ABERTA
  EM_ATENDIMENTO
  FINALIZADA
}

enum PortalIntegrationType {
  MANUAL
  XML
  API
}

enum PortalPublicationStatus {
  PENDENTE
  PUBLICADO
  ATUALIZADO
  ERRO
  REMOVIDO
}

enum MediaType {
  IMAGE
  VIDEO
  TOUR_360
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  online    Boolean  @default(false)
  active    Boolean  @default(true)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads         Lead[]         @relation("LeadAssignedTo")
  conversations Conversation[] @relation("ConversationAssignedTo")
  auditLogs     AuditLog[]

  @@index([role])
  @@index([online])
  @@map("users")
  personsCreated     Person[]   @relation("PersonCreatedBy")
  propertiesCreated  Property[] @relation("PropertyCreatedBy")
  propertiesUpdated  Property[] @relation("PropertyUpdatedBy")
}

model Person {
  id               String   @id @default(cuid())
  type             String
  fullName         String
  cpf              String?  @unique
  rg               String?
  email            String?  @unique
  phone            String?
  company          String?
  commercialPhone  String?
  residentialPhone String?
  contactPhone     String?
  whatsapp         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  properties   Property[]
  documents    Document[]
  appointments Appointment[]
  proposals    Proposal[]

  @@index([type])
  @@index([fullName])
  @@map("persons")
  category       String?
  firstContact   String?
  notes          String?
  isActive       Boolean  @default(true)
  archived       Boolean  @default(false)
  createReminder Boolean  @default(false)
  createdById    String?
  createdBy      User?    @relation("PersonCreatedBy", fields: [createdById], references: [id])
  businessTemperature String? @default("FRIO")
  activities          Json?
}

model Property {
  id          String         @id @default(cuid())
  title       String
  code        String?        @unique
  description String?
  seoTitle       String?
  seoKeywords    String?
  seoDescription String?
  price       Float?
  rentPrice   Float?
  promoPrice  Float?
  type        String?
  category    String?        @default("Normal")
  purpose     String?        @default("Residencial")
  status      PropertyStatus @default(DISPONIVEL)

  street           String?
  number           String?
  complement       String?
  block            String?
  apartment        String?
  zipCode          String?
  district         String?
  officialDistrict String?
  city             String?
  state            String?
  country          String? @default("Brasil")

  area        Float?
  builtArea   Float?
  usableArea  Float?
  totalArea   Float?
  rooms       Int?
  suites      Int?
  bathrooms   Int?
  garage      Int?
  livingRooms Int?
  floor       String?

  furnished Boolean @default(false)
  financed  Boolean @default(false)
  exchange  Boolean @default(false)

  financing        String? @default("NAO_INFORMADO")
  condominiumValue Float?
  iptuValue        Float?
  iptuPayment      String?

  publishOnSite      Boolean @default(true)
  siteHighlight      Boolean @default(false)
  publishOnPortals   Boolean @default(false)
  highlightOnPortals Boolean @default(false)
  valueOnRequest     Boolean @default(false)
  negotiable         Boolean @default(false)

  internalDescription String?
  captorName          String?

  indicationName String?
  indicationCommissionPercent Float?
  indicationCommissionValue Float?

  partnershipName String?
  partnershipCommissionPercent Float?
  partnershipCommissionValue Float?

  inspectionName String?
  inspectionCommissionPercent Float?
  inspectionCommissionValue Float?

  brokerName String?
  brokerCommissionPercent Float?
  brokerCommissionValue Float?

  images     Json?
  coverImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String?
  owner   Person? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User? @relation("PropertyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User? @relation("PropertyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  documents          Document[]
  proposals          Proposal[]
  medias             PropertyMedia[]
  portalPublications PropertyPortalPublication[]
  leads              Lead[]
  marketingCampaigns MarketingCampaign[]

  @@index([status])
  @@index([type])
  @@index([city])
  @@index([district])
  @@index([publishOnSite])
  @@index([publishOnPortals])
  @@index([createdById])
  @@index([updatedById])
  @@map("properties")
}

model PropertyMedia {
  id          String    @id @default(cuid())
  type        MediaType @default(IMAGE)
  url         String
  description String?
  isPrimary   Boolean   @default(false)
  publish     Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([isPrimary])
  @@index([publish])
  @@map("property_medias")
}

model Document {
  id        String   @id @default(cuid())
  title     String
  type      String
  filePath  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personId   String?
  propertyId String?

  person   Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([personId])
  @@index([propertyId])
  @@map("documents")
}

model Appointment {
  id        String   @id @default(cuid())
  date      DateTime
  notes     String?
  status    String   @default("AGENDADO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId String?
  client   Person? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([clientId])
  @@map("appointments")
}

model Proposal {
  id        String   @id @default(cuid())
  value     Float
  status    String   @default("PENDENTE")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId   String?
  propertyId String?

  client   Person?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([propertyId])
  @@index([status])
  @@map("proposals")
}

model PropertyRequest {
  id           String   @id @default(cuid())
  ownerName    String?
  name         String?
  email        String?
  phone        String?
  whatsapp     String?
  propertyType String?
  address      String?
  city         String?
  state        String?
  message      String?
  status       String   @default("NOVO")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("property_requests")
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  message   String?
  source    String?
  sourceDetail String?
  status    LeadStatus @default(NOVO)
  temperature LeadTemperature @default(FRIO)

  // Qualificação financeira
  monthlyIncome      Float?
  familyIncome       Float?
  downPayment        Float?
  hasFgts            Boolean?
  fgtsValue          Float?
  needsFinancing     Boolean?
  financingApproved  Boolean?

  // Interesse do cliente
  desiredRegion String?
  desiredCity   String?
  purchaseTime  String?
  notes         String?
  lossReason    String?

  // Rastreamento de campanhas
  campaignId    String?
  campaignName  String?
  adSetId       String?
  adSetName     String?
  adId          String?
  adName        String?

  metaLeadId     String?
  metaCampaignId String?
  metaAdSetId    String?
  metaAdId       String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  // Datas importantes do funil
  firstContactAt DateTime?
  qualifiedAt    DateTime?
  visitAt        DateTime?
  proposalAt     DateTime?
  convertedAt    DateTime?
  lostAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  conversations Conversation[]

  @@index([status])
  @@index([source])
  @@index([temperature])
  @@index([assignedToId])
  @@index([propertyId])
  @@index([campaignId])
  @@index([metaCampaignId])
  @@index([createdAt])
  @@map("leads")
}

model LeadDistribution {
  id                 String   @id @default(cuid())
  brokerId           String?
  brokerName         String?
  lastAssignedUserId String?
  active             Boolean  @default(true)
  position           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active])
  @@index([position])
  @@index([lastAssignedUserId])
  @@map("lead_distribution")
}

model Conversation {
  id           String             @id @default(cuid())
  visitorName  String?
  visitorPhone String?
  visitorEmail String?
  status       ConversationStatus @default(ABERTA)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("ConversationAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  messages Message[]

  @@index([status])
  @@index([leadId])
  @@index([assignedToId])
  @@map("conversations")
}

model Message {
  id         String   @id @default(cuid())
  text       String
  sender     String
  senderType String?
  senderName String?
  createdAt  DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Portal {
  id              String                @id @default(cuid())
  name            String
  slug            String?               @unique
  active          Boolean               @default(true)
  integrationType PortalIntegrationType @default(MANUAL)
  apiUrl          String?
  apiKey          String?
  xmlUrl          String?
  lastSync        DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  publications PropertyPortalPublication[]

  @@index([active])
  @@index([integrationType])
  @@map("portals")
}

model PropertyPortalPublication {
  id           String                  @id @default(cuid())
  status       PortalPublicationStatus @default(PENDENTE)
  externalCode String?
  externalUrl  String?
  lastSync     DateTime?
  error        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  propertyId String
  portalId   String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  portal   Portal   @relation(fields: [portalId], references: [id], onDelete: Cascade)

  logs PortalSyncLog[]

  @@unique([propertyId, portalId])
  @@index([status])
  @@index([propertyId])
  @@index([portalId])
  @@map("property_portal_publications")
}

model PortalSyncLog {
  id        String   @id @default(cuid())
  message   String
  success   Boolean
  payload   Json?
  response  Json?
  createdAt DateTime @default(now())

  publicationId String
  publication   PropertyPortalPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId])
  @@index([success])
  @@index([createdAt])
  @@map("portal_sync_logs")
}

model CompanySettings {
  id          String   @id @default(cuid())
  name        String
  tradingName String?
  cnpj        String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("company_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SiteVisit {
  id        String   @id @default(cuid())
  page      String
  eventType String   @default("PAGE_VIEW")
  propertyId String?
  source    String?
  referrer  String?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([page])
  @@index([eventType])
  @@index([propertyId])
  @@index([source])
  @@index([createdAt])
  @@map("site_visits")
}

model MarketingCampaign {
  id                  String   @id @default(cuid())
  name                String
  platform            String   @default("META_ADS")
  objective           String?
  status              String   @default("RASCUNHO")
  budget              Float?   @default(0)
  spent               Float    @default(0)
  revenueGenerated    Float    @default(0)
  commissionGenerated Float    @default(0)
  startDate           DateTime?
  endDate             DateTime?
  notes               String?
  externalCampaignId  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([platform])
  @@index([status])
  @@index([propertyId])
  @@index([startDate])
  @@index([createdAt])
  @@map("marketing_campaigns")
}
